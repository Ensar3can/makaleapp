{
  "name": "@aip/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "typecheck": "node ../../scripts/prisma-generate.mjs && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx src/seed.ts",
    "db:ensure": "tsx src/cli-ensure-database.ts",
    "db:wait": "tsx src/cli-wait-for-database.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aip/auth": "workspace:*",
    "@aip/config": "workspace:*",
    "@aip/domain": "workspace:*",
    "@prisma/client": "^6.14.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
