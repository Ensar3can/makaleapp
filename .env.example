NODE_ENV=development
APP_URL=http://localhost:3000

# sqlcmd probe uses the named instance. Prisma uses TCP 1433 (enable via scripts/enable-sqlexpress-tcp.ps1).
SQLSERVER_INSTANCE=.\SQLEXPRESS
DATABASE_URL=sqlserver://localhost:1433;database=aip;integratedSecurity=true;trustServerCertificate=true;encrypt=true
TEST_DATABASE_URL=sqlserver://localhost:1433;database=aip_test;integratedSecurity=true;trustServerCertificate=true;encrypt=true

# Use memory:// until Memurai/Redis is installed. The worker then polls due AnalysisJob rows.
# With Redis/Memurai, web also enqueues through BullMQ: redis://127.0.0.1:6379
REDIS_URL=memory://local

OBJECT_STORAGE_ROOT=.data/storage
OBJECT_STORAGE_DRIVER=local-disk
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=aip
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

AI_PROVIDER=fake
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

MAX_ARTICLE_SIZE=10000000
MAX_ARTICLE_WORDS=20000
MAX_AI_COST_PER_ANALYSIS=1

SESSION_COOKIE_NAME=aip_session
SESSION_TTL_SECONDS=604800
SESSION_PEPPER=
