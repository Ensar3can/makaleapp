# Real-host production template. Do not commit the filled file.
# Copy to the host env or your secret manager.

NODE_ENV=production
APP_URL=https://articles.example
SESSION_PEPPER=replace-with-32-plus-random-chars
SESSION_COOKIE_NAME=aip_session
SESSION_TTL_SECONDS=604800

DATABASE_URL=sqlserver://USER:PASSWORD@sql-host:1433;database=aip;encrypt=true;trustServerCertificate=false
SQLSERVER_INSTANCE=sql-host

REDIS_URL=redis://:PASSWORD@redis-host:6379

OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_BUCKET=aip
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_FORCE_PATH_STYLE=false

AI_PROVIDER=fake
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

MAX_ARTICLE_SIZE=10000000
MAX_ARTICLE_WORDS=20000
MAX_AI_COST_PER_ANALYSIS=1
